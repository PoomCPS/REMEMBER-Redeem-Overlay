{
    "meta": {
        "theme": "analog-tape-1980",
        "strictMode": true
    },
    "colorEconomy": {
        "canvas": {
            "paper": "#F4F1EA",
            "tapeBlack": "#121212",
            "sleeveGray": "#E2DFD7"
        },
        "ink": {
            "primary": "#1A1A1A",
            "muted": "#5C5A54",
            "inverse": "#F4F1EA"
        },
        "accents": {
            "signalRed": "#E63946",
            "analogOrange": "#F77F00",
            "tapeYellow": "#FCBF49",
            "ferricBlue": "#0096C7",
            "vhsGreen": "#2A9D8F"
        },
        "rules": {
            "maxAccentsPerCard": 4,
            "allowGradients": false,
            "accentUsage": "stripes-and-badges-only"
        }
    },
    "geometry": {
        "borderRadius": "0px",
        "borderWidth": {
            "grid": "1px",
            "heavy": "2px"
        },
        "shadows": "none"
    },
    "typography": {
        "display": "'Archivo Black', 'Helvetica Neue', sans-serif",
        "body": "'Inter', sans-serif",
        "mono": "'JetBrains Mono', monospace"
    },
    "motion": {
        "duration": "0ms",
        "hoverTransition": "75ms steps(1)"
    }
}