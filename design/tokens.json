{
    "meta": {
        "theme": "analog-tape-1980",
        "strictMode": true,
        "references": [
            {
                "title": "Instagram can't touch the visual glory of blank VHS tapes",
                "author": "Antony Terence",
                "publication": "UX Collective",
                "url": "https://uxdesign.cc/instagram-cant-touch-the-visual-glory-of-blank-vhs-tapes-8c165b683a1e"
            },
            {
                "title": "The Art and Design of Blank VHS Tapes: A Lost Graphic Design Genre",
                "author": "Jude Smith",
                "publication": "DESIGN SMITH LTD",
                "url": "https://www.designsmithstudio.co.uk/blogs/off-the-page/the-art-and-design-of-vhs-boxes"
            },
            {
                "title": "The Best 15 VHS Color Palette Ideas for Video & Design",
                "publication": "Wondershare Filmora",
                "url": "https://filmora.wondershare.com/video-creative-tips/vhs-color-color-palette.html"
            }
        ]
    },
    "colorEconomy": {
        "canvas": {
            "paper": "#F4F1EA",
            "tapeBlack": "#121212",
            "sleeveGray": "#E2DFD7"
        },
        "ink": {
            "primary": "#1A1A1A",
            "muted": "#5C5A54",
            "inverse": "#F4F1EA"
        },
        "accents": {
            "signalRed": "#E63946",
            "analogOrange": "#F77F00",
            "tapeYellow": "#FCBF49",
            "ferricBlue": "#0096C7",
            "vhsGreen": "#2A9D8F"
        },
        "rules": {
            "maxAccentsPerCard": 5,
            "allowGradients": false,
            "accentUsage": "stripes-and-badges-only"
        }
    },
