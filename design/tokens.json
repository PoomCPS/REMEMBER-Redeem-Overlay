    "geometry": {
        "borderRadius": "0px",
        "borderWidth": {
            "grid": "1px",
            "heavy": "2px"
        },
        "shadows": "none",
        "hardShadows": {
            "card": "3px 3px 0px #1A1A1A",
            "button": "2px 2px 0px #1A1A1A",
            "subtle": "1px 1px 0px #1A1A1A"
        }
    },
    "typography": {
        "display": "'Archivo Black', 'Space Grotesk', 'Kanit', -apple-system, sans-serif",
        "body": "'Inter', 'Kanit', sans-serif",
        "mono": "'JetBrains Mono', 'Space Mono', monospace"
    },
    "motion": {
        "duration": "0ms",
        "hoverTransition": "75ms steps(1)"
    }
}
