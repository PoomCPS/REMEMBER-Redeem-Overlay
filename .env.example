# Server Configuration
PORT=3000
HOST=127.0.0.1

# Twitch Application Credentials (from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# OBS WebSocket Settings (OBS Studio -> Tools -> WebSocket Server Settings)
# Default port for OBS WebSocket v5 is 4455
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

# Allowed Reward Whitelist (only these specific rewards will be shown on overlay)
ALLOWED_REWARDS=รักแรกมันแยกยาก,คนแรกเลยล่ะ,กระผมมาเป็นคนแรกเลยนะ
